# ==============================================================================
# NER-SHIELD Backend: Environment Variables Template
# ==============================================================================

# Server Network Configuration
APP_NAME=NER-SHIELD-Core
ENVIRONMENT=development
DEBUG=True
HOST=127.0.0.1
PORT=5000

# CORS Whitelist (Comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Persistence & Storage (Default: Asynchronous Local SQLite)
DATABASE_URL=sqlite+aiosqlite:///./ner_shield.db

# Authentication & Cryptographic Keys
JWT_SECRET=super_secret_ner_shield_jwt_key_development_only_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Machine Learning & Routing Binary Artifact Paths
MODEL_PATH=scripts/risk_model.pkl
GRAPH_PATH=scripts/road_graph.pickle

# External Data Services (Keyless APIs)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
RAINVIEWER_BASE_URL=https://api.rainviewer.com/public/weather-maps.json